# =====================================================
# ARCA — Variables de Entorno (arca-app)
# Copia este archivo como .env.local y completa los valores
# =====================================================

# Ruta de la base de datos SQLite (opcional — por defecto ./arca-data/arca.db)
# ARCA_DB_PATH=./arca-data/arca.db

# Gemini — opcional. Activa el chat en lenguaje natural, la clasificación de
# documentos por contenido y el OCR de imágenes. Alternativa: pegar la key en
# Ajustes ⚙ dentro de la app (se guarda en la base local). Sin key, ARCA
# funciona 100% local con el clasificador por reglas.
# GEMINI_API_KEY=AIza...

# ARCA Admin — Required to authorize POST /api/init-team (team-mode sync setup)
ARCA_ADMIN_SECRET=change-me-to-a-secret-value
