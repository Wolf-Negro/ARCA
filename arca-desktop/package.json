{
  "name": "arca-desktop",
  "version": "0.1.7",
  "description": "ARCA — Asistente de Archivos para Agencias (Desktop)",
  "author": "Wolf-Negro",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "prebuild:win": "node scripts/stage-node-binary.js",
    "prebuild:mac": "node scripts/stage-node-binary.js",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.0"
  },
  "build": {
    "appId": "com.arca.desktop",
    "productName": "ARCA",
    "copyright": "ARCA — Agencia",
    "files": [
      "main.js",
      "tray.js",
      "preload.js",
      "preload-onboarding.js",
      "onboarding.html"
    ],
    "publish": {
      "provider": "github",
      "owner": "Wolf-Negro",
      "repo": "ARCA"
    },
    "extraResources": [
      {
        "from": "../arca-app/public/icon-192.png",
        "to": "tray-icon.png"
      },
      {
        "from": "../arca-app/.next/standalone",
        "to": "app",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../arca-app/.next/static",
        "to": "app/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../arca-app/public",
        "to": "app/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../arca-app/public/icon-512.png",
      "artifactName": "ARCA-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": ".staging/node.exe",
          "to": "node/node.exe"
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "../arca-app/public/icon-512.png",
      "category": "public.app-category.productivity",
      "identity": null,
      "artifactName": "ARCA-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": ".staging/node",
          "to": "node/node"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
