# ── Panel admin login ────────────────────────────────────────────────────────

# Password required to log in to arca-panel (compared against the value the
# admin submits on the /login screen). Choose your own value.
PANEL_ADMIN_PASSWORD=

# Secret used to sign session cookies (HMAC-SHA256). Must be a long, random,
# unguessable value — DO NOT reuse PANEL_ADMIN_PASSWORD here, this is a
# separate server-side signing secret, not a password.
# Generate one with, e.g.: openssl rand -base64 48
PANEL_SESSION_SECRET=

# ── Supabase project (Settings → API in the Supabase dashboard) ──────────────

# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Anon/publishable key. Sent back to arca-desktop by /api/activate as `anonKey`
# — arca-app uses it only for the PostgREST `apikey` header; it is NOT what
# authorizes access to a specific agency's rows (see SUPABASE_JWT_SECRET).
SUPABASE_ANON_KEY=

# Service role key — bypasses Row Level Security. Used server-side only
# (lib/db.ts) to manage agencies (create/list/toggle/delete) and to look up
# an agency by activation code. NEVER expose this to arca-app or any client;
# it must only ever live in arca-panel's own server environment.
SUPABASE_SERVICE_KEY=

# Your Supabase project's JWT secret (Settings → API → JWT Settings in the
# Supabase dashboard — NOT the same as SUPABASE_ANON_KEY or SUPABASE_SERVICE_KEY).
# Used to sign a per-agency JWT in /api/activate, which replaces handing out
# the same anon key to every agency — Postgres RLS policies check
# `auth.jwt() ->> 'team_id'` against this token, so each agency's key can only
# read/write its own rows.
SUPABASE_JWT_SECRET=
