# Password required to log in to arca-panel (compared against the value the
# admin submits on the /login screen).
PANEL_ADMIN_PASSWORD=

# Secret used to sign session cookies (HMAC-SHA256). Must be a long, random,
# unguessable value — DO NOT reuse PANEL_ADMIN_PASSWORD here, this is a
# separate server-side signing secret, not a password.
# Generate one with, e.g.: openssl rand -base64 48
PANEL_SESSION_SECRET=
